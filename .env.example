# Copy to `.env` for local overrides. Nothing here is a secret.
# `.env` is git-ignored; the daily workflow does not read it (it uses
# repository variables/secrets instead, see README "GitHub Actions" section).

# GitHub username whose public profile/contribution graph is rendered.
PROFILE_GITHUB_USERNAME=shreyanshmishra8899-lab

# Display name shown on the info card and in the README.
PROFILE_DISPLAY_NAME=Shreyansh

# One-line current status, shown as the "status" row on the info card.
PROFILE_ROLE=Not employed yet - open to work

# Previous experience, shown as the "experience" row on the info card.
PROFILE_EXPERIENCE=Internships at 2 companies

# --- Optional, for scripts/fetch_contributions.py ---
# A fine-grained or classic GitHub PAT with no scopes beyond public read
# access (or simply omitted) enables the GraphQL fallback, which is more
# reliable than scraping the public contributions HTML page. Never commit
# a real token: set it as a repo/organization "Actions secret" named
# GH_CONTRIB_TOKEN for the workflow, and/or export it locally for testing.
# GH_CONTRIB_TOKEN=
